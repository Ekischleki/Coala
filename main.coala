#Defines as super value which can only be used as a constant to expand loop macros.

problem {

    
    sub test_count() {
        let INT_LENGTH = 4
        let a = int_be::from_super_seeded(4, INT_LENGTH)
        let b = int_be::from_super_seeded(8, INT_LENGTH) 
        let out = int_be::add(a, b)
        for (i in INT_LENGTH) {
            partial out.data[super::sb(super::sb(INT_LENGTH, 1), i)]
        }
    }

}


solution {
    test_sha(true, false)
}


 